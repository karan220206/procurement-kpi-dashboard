table dim_vendor
	lineageTag: ad4f1ed7-d585-5ed9-b9e2-4a9ba2fb3d22

	measure 'High-Risk Vendors' = CALCULATE(COUNTROWS(dim_vendor), dim_vendor[risk_tier] = "High")
		formatString: #,0
		lineageTag: 0e2cb4d7-5534-51e9-a287-6240dddba136

	measure 'Red-Flag Vendors' = CALCULATE(COUNTROWS(dim_vendor), dim_vendor[red_flags] <> "")
		formatString: #,0
		lineageTag: df0dc136-7212-5ee3-8156-b65785b916ac

	measure 'High-Risk Spend Share %' = DIVIDE(CALCULATE([Spend (₹ cr)], dim_vendor[risk_tier] = "High"), [Spend (₹ cr)])
		formatString: 0.0%
		lineageTag: 5996fcdb-e841-5741-be40-25fca3a4dd17

	measure 'Avg Risk Score' = AVERAGE(dim_vendor[risk_score])
		formatString: 0.0
		lineageTag: cb3893d5-f0e7-5791-9845-10b8d0bdd333

	measure 'Performance Risk' = AVERAGE(dim_vendor[performance_score])
		formatString: 0.0
		lineageTag: a9ce0c91-eb9d-5351-a0e7-34880120a18f

	measure Exposure = AVERAGE(dim_vendor[exposure_score])
		formatString: 0.0
		lineageTag: 3679be6f-0b43-5a7a-9f5e-8f679c60addb

