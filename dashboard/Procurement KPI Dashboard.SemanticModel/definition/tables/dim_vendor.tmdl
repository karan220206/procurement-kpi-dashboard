	partition dim_vendor = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\data\powerbi\dim_vendor.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"vendor_id", type text}, {"vendor_label", type text}, {"vendor_name", type text}, {"vendor_category", type text}, {"city", type text}, {"vendor_state", type text}, {"payment_terms", type text}, {"risk_rank", type number}, {"risk_score", type number}, {"risk_tier", type text}, {"red_flags", type text}, {"main_driver", type text}, {"performance_score", type number}, {"exposure_score", type number}, {"category_share_pct", type number}, {"otd_change_pp", type number}}, "en-US")
				in
				    Typed

