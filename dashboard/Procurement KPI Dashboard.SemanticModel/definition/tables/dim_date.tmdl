table dim_date
	lineageTag: b1631c12-74c0-5ab6-bd51-3ce32526fcda
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd-mmm-yyyy
		lineageTag: 63e246a3-0402-52c6-b141-3d5310c0edac
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 348d814a-11d7-5b2e-be18-f3ef946fd54b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: ba956ba8-faa6-53e3-b1e9-9a99a91bae47
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

	column Month
		dataType: string
		lineageTag: 4bbf8f42-aff3-512e-95f3-64ade3a5731d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Start'

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 588b327a-cb7d-54d1-880c-30e332048044
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

	partition dim_date = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2023, 1, 1), DATE(2026, 3, 31)), "Year", YEAR([Date]), "Month No", MONTH([Date]), "Month", FORMAT([Date], "mmm yyyy"), "Month Start", DATE(YEAR([Date]), MONTH([Date]), 1))

