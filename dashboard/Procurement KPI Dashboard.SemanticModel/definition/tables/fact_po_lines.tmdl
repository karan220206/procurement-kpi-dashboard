table fact_po_lines
	lineageTag: d408c56e-45df-541f-853b-419f0669209e

	measure 'Spend (₹ cr)' = DIVIDE(SUM(fact_po_lines[line_value]), 10000000)
		formatString: #,0.0
		displayFolder: Spend
		lineageTag: 006d9827-25df-5fab-8603-20c084a1cef4

	measure 'PO Lines' = COUNTROWS(fact_po_lines)
		formatString: #,0
		displayFolder: Spend
		lineageTag: 8651fcc3-9057-511f-82f0-0e316466aa4d

	measure 'Lines Due' = CALCULATE(COUNTROWS(fact_po_lines), fact_po_lines[is_due] = 1)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 0b057e3b-87ae-5f18-acd0-630030356fdb

	measure 'OTD %' = DIVIDE(CALCULATE(COUNTROWS(fact_po_lines), fact_po_lines[is_due] = 1, fact_po_lines[is_on_time] = 1), [Lines Due])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 7aeda2fb-68b2-5748-8bd3-5e1cf929c585

	measure 'OTIF %' = DIVIDE(CALCULATE(COUNTROWS(fact_po_lines), fact_po_lines[is_due] = 1, fact_po_lines[is_otif] = 1), [Lines Due])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 39172dd3-b17b-58b3-a517-e8290da89ecc

	measure 'Fill Rate %' = DIVIDE(SUM(fact_po_lines[qty_filled_due]), SUM(fact_po_lines[qty_due]))
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 0b7066e8-9124-55dd-934a-9b3d8aaf6533

	measure 'Avg Delay (days)' = CALCULATE(AVERAGE(fact_po_lines[delay_days]), fact_po_lines[delay_days] > 0)
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 491d9374-5859-5f43-8cca-1732d3987bc6

	measure 'Avg Lead Time (days)' = AVERAGE(fact_po_lines[lead_time_days])
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 85db7b66-b4d1-563c-a7c0-fb29d89872e5

	measure 'Overdue Open Lines' = CALCULATE(COUNTROWS(fact_po_lines), fact_po_lines[is_due] = 1, fact_po_lines[line_status] = "Open")
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 16469f4e-aa72-5a38-bb98-d52b8d9f01b0

	measure 'Rejection Rate %' = DIVIDE(SUM(fact_po_lines[qty_rejected]), SUM(fact_po_lines[qty_inspected]))
		formatString: 0.00%
		displayFolder: Quality
		lineageTag: 6ca4dcff-2bae-571a-8e58-45ef55ca42e7

	measure 'Receipts with Rejections %' = DIVIDE(SUM(fact_po_lines[receipts_with_rejection]), SUM(fact_po_lines[receipts_inspected]))
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 334869c8-3394-50b6-9c2d-c0703996ff64

	measure 'Urgent Orders %' = DIVIDE(CALCULATE(COUNTROWS(fact_po_lines), fact_po_lines[order_type] = "Urgent"), [PO Lines])
		formatString: 0.0%
		displayFolder: Buying
		lineageTag: 081684a7-693a-57f0-a3a7-c74369fe967d

	measure 'Bulk Orders %' = DIVIDE(CALCULATE(COUNTROWS(fact_po_lines), fact_po_lines[order_type] = "Bulk"), [PO Lines])
		formatString: 0.0%
		displayFolder: Buying
		lineageTag: e5ebc3fe-762e-533a-a10f-4f36a6d52294

	measure 'Bulk Savings (₹ cr)' = DIVIDE(SUM(fact_po_lines[bulk_saving]), 10000000)
		formatString: #,0.0
		displayFolder: Buying
		lineageTag: 96577baf-cb1a-5a4b-a981-c9099b0e19ae

	measure 'Urgent Premium (₹ cr)' = DIVIDE(SUM(fact_po_lines[urgent_premium]), 10000000)
		formatString: #,0.00
		displayFolder: Buying
		lineageTag: d78e968f-c88f-5714-b469-5749e8bcbc22

	measure 'PPV vs Standard %' = DIVIDE(SUMX(fact_po_lines, (fact_po_lines[unit_price] - fact_po_lines[standard_price]) * fact_po_lines[quantity]), SUMX(fact_po_lines, fact_po_lines[standard_price] * fact_po_lines[quantity]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Buying
		lineageTag: 2a5dbfd3-8934-5f5e-897d-f2cd28458a58

	measure 'Top Vendor Share %' = DIVIDE(MAXX(VALUES(fact_po_lines[vendor_id]), CALCULATE(SUM(fact_po_lines[line_value]))), SUM(fact_po_lines[line_value]))
		formatString: 0.0%
		displayFolder: Dependency
		lineageTag: a279bd8b-f419-53f4-af29-16388b7a2aac

	measure 'Top 5 Vendor Share %' = DIVIDE(SUMX(TOPN(5, VALUES(fact_po_lines[vendor_id]), CALCULATE(SUM(fact_po_lines[line_value]))), CALCULATE(SUM(fact_po_lines[line_value]))), SUM(fact_po_lines[line_value]))
		formatString: 0.0%
		displayFolder: Dependency
		lineageTag: 7151fd78-442b-5131-9b9b-94608ee171b8

	measure 'Vendor HHI' = VAR total = SUM(fact_po_lines[line_value]) RETURN SUMX(VALUES(fact_po_lines[vendor_id]), DIVIDE(CALCULATE(SUM(fact_po_lines[line_value])), total) ^ 2) * 10000
		formatString: #,0
		displayFolder: Dependency
		lineageTag: bf9e3fe5-a541-53b8-9a2a-1f92b85d36eb

	measure 'Single-Source Items %' = VAR bought = VALUES(fact_po_lines[item_id]) RETURN DIVIDE(COUNTROWS(FILTER(bought, CALCULATE(DISTINCTCOUNT(fact_po_lines[vendor_id])) = 1)), COUNTROWS(bought))
		formatString: 0.0%
		displayFolder: Dependency
		lineageTag: ea98828c-22f9-5e43-b9c9-e2e98bd45ba0

