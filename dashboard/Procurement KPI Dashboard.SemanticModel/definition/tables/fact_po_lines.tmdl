	partition fact_po_lines = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\data\powerbi\fact_po_lines.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"po_id", type text}, {"line_no", Int64.Type}, {"order_date", type date}, {"promised_date", type date}, {"order_type", type text}, {"buyer_id", type text}, {"vendor_id", type text}, {"item_id", type text}, {"quantity", Int64.Type}, {"unit_price", type number}, {"standard_price", type number}, {"line_value", type number}, {"qty_received", type number}, {"qty_rejected", type number}, {"qty_inspected", type number}, {"receipts_with_rejection", type number}, {"receipts_inspected", type number}, {"lead_time_days", type number}, {"delay_days", type number}, {"is_due", Int64.Type}, {"is_on_time", Int64.Type}, {"is_otif", Int64.Type}, {"is_monsoon_month", Int64.Type}, {"line_status", type text}, {"qty_due", type number}, {"qty_filled_due", type number}, {"bulk_saving", type number}, {"urgent_premium", type number}}, "en-US")
				in
				    Typed

